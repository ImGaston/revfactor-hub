NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ASSEMBLY_API_KEY=
PRICELABS_API_KEY=
PREDICTHQ_ACCESS_TOKEN=
# PredictHQ is retained as a reference archive. Keep ingestion disabled unless
# an explicitly approved temporary recovery run is needed.
PREDICTHQ_INGESTION_ENABLED=false
TICKETMASTER_API_KEY=
# SeatGeek adapter credentials (adapter wiring follows after credentials exist).
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
# Optional free key for structured NCAA football schedules.
CFBD_API_KEY=
# A key alone must not start ingestion. Enable only after the market/source
# mapping and release boundary have been reviewed.
CFBD_INGESTION_ENABLED=false
# NWS requires an identifying User-Agent, not an API key.
NWS_USER_AGENT=(hub.revfactor.io, info@revfactor.io)
# Official university rows remain individually inactive until researched and
# reviewed. This second execution gate must also stay false by default.
UNIVERSITY_PAGE_INGESTION_ENABLED=false
# Optional: pin the Report Builder template id. If unset, the "rm-listings"
# template is resolved by name from /report_builder/templates.
PRICELABS_REPORT_TEMPLATE_ID=
CRON_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRIMARY_LISTING_PRICE_ID=
STRIPE_CHILD_LISTING_PRICE_ID=
STRIPE_ONBOARDING_FEE_PRICE_ID=
ONBOARDING_CHECKOUT_SUCCESS_URL=
ONBOARDING_CHECKOUT_CANCEL_URL=
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_ONBOARDING_TEMPLATE_ID=
HIGHLEVEL_ONBOARDING_CHILD_TEMPLATE_ID=
HIGHLEVEL_ONBOARDING_SENDER_USER_ID=
# Optional overrides for the inline GHL agreement flow.
HIGHLEVEL_ONBOARDING_TEMPLATE_NAME=RevFactor_Service_Agreement
HIGHLEVEL_ONBOARDING_CHILD_TEMPLATE_NAME=RevFactor_Service_Agreement_With_Child_Listings
HIGHLEVEL_DOCUMENT_SIGNING_BASE_URL=https://links.revfactor.io
HIGHLEVEL_ONBOARDING_ALLOWED_ORIGINS=https://links.revfactor.io
HIGHLEVEL_ONBOARDING_WEBHOOK_SECRET=
HIGHLEVEL_SIGNUP_WEBHOOK_SECRET=
# Local Agent Studio model access. Vercel deployments can use project OIDC.
AI_GATEWAY_API_KEY=
# Enable only after migration 037 is applied and Stripe metadata is configured.
ONBOARDING_ENTITLEMENT_SYNC_ENABLED=false
# Scheduler page → pipeline webhook
SCHEDULER_WEBHOOK_SECRET=
# Adjusment → Whatsapp group
WHATSAPP_GROUP_INVITE_URL=
# Landing page → pipeline webhook (new-lead)
WEBHOOK_SECRET=
