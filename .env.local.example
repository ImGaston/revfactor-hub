NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ASSEMBLY_API_KEY=
PRICELABS_API_KEY=
# Optional: pin the Report Builder template id. If unset, the "rm-listings"
# template is resolved by name from /report_builder/templates.
PRICELABS_REPORT_TEMPLATE_ID=
CRON_SECRET=
STRIPE_SECRET_KEY=
# Local Agent Studio model access. Vercel deployments can use project OIDC.
AI_GATEWAY_API_KEY=
# Optional Agent Studio sandbox observability. Use a fresh workspace-scoped
# LangSmith service key. Keep global auto-tracing off: the server explicitly
# enables only built-in synthetic Pricing & Performance flow runs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=revfactor-agent-studio-sandbox
LANGCHAIN_CALLBACKS_BACKGROUND=false
# Enable only after migration 037 is applied and Stripe metadata is configured.
ONBOARDING_ENTITLEMENT_SYNC_ENABLED=false
SCHEDULER_WEBHOOK_SECRET=
