{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "revfactor-ghl-inline-onboarding",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "revfactor-ghl-inline-onboarding-staging",
      "vars": {
        "HIGHLEVEL_LOCATION_ID": "ErABPRqWbMyIicvzvCFt",
        "HIGHLEVEL_ONBOARDING_TEMPLATE_ID": "6a88b36bf6fb5d14abd2fbfe",
        "HIGHLEVEL_ONBOARDING_CHILD_TEMPLATE_ID": "6a89a4cff6fb5d14abe08d13",
        "HIGHLEVEL_ONBOARDING_SENDER_USER_ID": "1WgQNxn4PlbERLBzGG6o",
        "HIGHLEVEL_ONBOARDING_TEMPLATE_NAME": "RevFactor_Service_Agreement",
        "HIGHLEVEL_ONBOARDING_CHILD_TEMPLATE_NAME": "RevFactor_Service_Agreement_With_Child_Listings",
        "HIGHLEVEL_DOCUMENT_SIGNING_BASE_URL": "https://links.revfactor.io",
        "HIGHLEVEL_ONBOARDING_ALLOWED_ORIGIN": "https://links.revfactor.io",
      },
    },
  },
}
