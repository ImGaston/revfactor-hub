{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "revfactor-ghl-inline-onboarding",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "exports": {
    "AgreementClaimCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGREEMENT_CLAIMS",
        "class_name": "AgreementClaimCoordinator",
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "revfactor-ghl-inline-onboarding-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "AGREEMENT_CLAIMS",
            "class_name": "AgreementClaimCoordinator",
          },
        ],
      },
      "vars": {
        "HIGHLEVEL_LOCATION_ID": "ErABPRqWbMyIicvzvCFt",
