+import { ArrowRight } from "lucide-react";
+import type { AcceptedGhlHandoff } from "@/lib/ghl-accepted-handoff";
+
+export function AcceptedOnboardingSummary({ handoff: acceptedHandoff, onOpenMessages: requestHelp, notice }: {
+  handoff: AcceptedGhlHandoff; onOpenMessages: () => void; notice?: string;
+}) {
+    const goalLabels = { revenue: "Revenue", occupancy: "Occupancy", balanced: "Balanced revenue and occupancy", guidance: "Guidance requested" };
+    const statusLabel = { done: "Access shared — team verification pending", need_help: "Setup help requested", not_applicable: "Not applicable — team confirmation pending" };
+    const moneyLabel = (value: AcceptedGhlHandoff["properties"][number]["preferences"]["minimumNightly"]) => value.mode === "specified" ? new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(value.value) : value.mode === "guidance" ? "Guidance requested" : "No firm restriction";
+    return (
+      <main className="app-shell">
+        <nav className="brand-nav" aria-label="RevFactor onboarding summary"><span className="wordmark">revfactor</span><span className="nav-pill soft">Information received</span></nav>
+        <section className="access-gate-panel" style={{ width: "min(100% - 32px, 900px)", margin: "32px auto", textAlign: "left" }}>
+          <p className="eyebrow">Your accepted onboarding</p>
+          <h1>Your property information is complete</h1>
+          <p>We have your onboarding information. You do not need to enter it again. Contact your team in Assembly Messages for software setup help or corrections.</p>
+          {acceptedHandoff.properties.map((property) => (
+            <section key={property.id} style={{ padding: "24px 0", borderTop: "1px solid #ddd" }} aria-label={property.name}>
+              <h2>{property.name}</h2>
+              <p>{Object.values(property.address).filter(Boolean).join(", ")}</p>
+              {property.listingUrl ? <p><a href={property.listingUrl} target="_blank" rel="noopener noreferrer">View your listing</a></p> : null}
+              <dl>
+                <dt>Property status</dt><dd>{property.status === "live" ? "Live" : "Preparing to launch"}</dd>
+                {property.status === "pre_launch" && property.targetLaunchDate ? <><dt>Target launch date</dt><dd>{new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(new Date(`${property.targetLaunchDate}T00:00:00Z`))}</dd></> : null}
+                <dt>Goal</dt><dd>{goalLabels[property.preferences.goal]}</dd>
+                <dt>Minimum nightly price</dt><dd>{moneyLabel(property.preferences.minimumNightly)}</dd>
+                <dt>Cleaning fee</dt><dd>{moneyLabel(property.preferences.cleaningFee)}</dd>
+                <dt>Minimum stay</dt><dd>{property.preferences.minimumStay.mode === "specified" ? `${property.preferences.minimumStay.nights} nights` : property.preferences.minimumStay.mode === "guidance" ? "Guidance requested" : "No firm restriction"}</dd>
+                {property.preferences.operatingConstraints ? <><dt>Operating constraints</dt><dd>{property.preferences.operatingConstraints}</dd></> : null}
+              </dl>
+            </section>
+          ))}
+          <section style={{ padding: "24px 0", borderTop: "1px solid #ddd" }} aria-label="Software setup">
+            <h2>Software setup</h2>
+            <p>{acceptedHandoff.software.pmsName || "PMS"}: {statusLabel[acceptedHandoff.software.pms]}</p>
+            <p>Airbnb: {statusLabel[acceptedHandoff.software.airbnb]}</p>
+            <p>PriceLabs: {statusLabel[acceptedHandoff.software.pricelabs]}</p>
+            <p>These are your submitted setup statuses. Access verification is separate from this information.</p>
+          </section>
+          <button className="primary-button" onClick={requestHelp}>Open Assembly Messages <ArrowRight size={16} /></button>
+          {notice ? <p role="status">{notice}</p> : null}
+        </section>
+      </main>
+    );
+}
