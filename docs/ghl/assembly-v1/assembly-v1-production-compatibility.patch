+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+vi.mock("server-only", () => ({}));
+const effects = vi.hoisted(() => ({ pdf: vi.fn(), upload: vi.fn() }));
+vi.mock("@/lib/assembly-session", () => ({ resolveAppAccess: async () => ({ ok: true, viewer: { mode: "assembly", surface: "client", companyId: "company", clientId: "client", workspaceId: "workspace", displayName: "Example Owner" } }) }));
+vi.mock("@/lib/assembly-notifications.server", () => ({ dispatchSubmissionNotifications: vi.fn() }));
+vi.mock("@/lib/assembly-files.server", () => ({ uploadClientLaunchPlan: effects.upload }));
+vi.mock("@/lib/handoff-pdf", () => ({ buildHandoffPdf: effects.pdf }));
+import { NextRequest } from "next/server";
+import { GET } from "@/app/api/onboarding/route";
+import { isGhlV1Run, parseAcceptedGhlHandoff } from "@/lib/ghl-accepted-handoff";
+import { AcceptedOnboardingSummary } from "@/components/accepted-onboarding-summary";
+import { loadHubInternalOnboardingQueue, loadHubOnboardingState, recordHubOnboardingAttachment, saveHubOnboardingState, verifyHubInternalOnboardingTask } from "@/lib/hub-persistence.server";
+import { createDefaultState } from "@/lib/onboarding-defaults";
+
+const id = (n: number) => `00000000-0000-4000-8000-${String(n).padStart(12, "0")}`;
+function run() {
+  return { id: id(1), external_key: `ghl-v1-${id(2)}`, client_id: "hub-client", revision: 1, status: "submitted", current_step: "review", primary_listing_entitlement: 1, child_listing_entitlement: 0, draft_payload: {}, submitted_at: "2026-09-04T12:00:00Z", submitted_payload: {
+    version: "rf.onboarding.v1", journeyId: id(2), expectationsAcknowledged: true,
+    properties: [{ id: id(3), name: "Property One", address: { street: "1 Example Street", unit: "", city: "Austin", region: "TX", postalCode: "00000", country: "US" }, listingUrl: "https://example.com/property", status: "live", targetLaunchDate: null, identityConfirmed: true, preferences: { goal: "guidance", minimumNightly: { mode: "guidance" }, cleaningFee: { mode: "specified", value: 150 }, minimumStay: { mode: "none" }, operatingConstraints: "Contact us before changing owner stays." }, billingAccountId: "private-billing-id" }],
+    software: { pmsName: null, pms: "not_applicable", airbnb: "need_help", pricelabs: "done" }, accounts: [{ secret: "private-commercial-data" }]
+  } };
+}
+const viewer = { mode: "assembly" as const, surface: "client" as const, companyId: "company", clientId: "client", workspaceId: "workspace", displayName: "Example Owner" };
+let rows: Array<Omit<ReturnType<typeof run>, "draft_payload" | "submitted_payload"> & { draft_payload: unknown; submitted_payload: unknown }> = [run()];
+let fetchMock = vi.fn<typeof fetch>();
+beforeEach(() => {
+  rows = [run()];
+  vi.stubEnv("REVFACTOR_SUPABASE_URL", "https://hub.invalid");
+  vi.stubEnv("REVFACTOR_SUPABASE_SERVICE_ROLE_KEY", "test-key");
+  effects.pdf.mockReset(); effects.upload.mockReset();
+  fetchMock = vi.fn<typeof fetch>(async (url) => {
+    const path = new URL(String(url)).pathname;
+    if (path.endsWith("/clients")) return Response.json([{ id: "hub-client", name: "Example Owner", assembly_company_id: "company" }]);
+    if (path.endsWith("/onboarding_runs")) return Response.json(rows);
+    return Response.json([]);
+  });
+  vi.stubGlobal("fetch", fetchMock);
+});
+afterEach(() => { vi.unstubAllGlobals(); vi.unstubAllEnvs(); });
+
+describe("accepted GHL handoff compatibility", () => {
+  it("recognizes both identifier formats and the explicit payload version", () => {
+    expect(isGhlV1Run(run())).toBe(true);
+    expect(isGhlV1Run({ ...run(), external_key: `ghl-v1:${id(2)}` })).toBe(true);
+    expect(isGhlV1Run({ ...run(), external_key: "unusual-but-versioned" })).toBe(true);
+  });
+  it("projects accepted property answers without commercial or provider data", () => {
+    const result = parseAcceptedGhlHandoff(run());
+    expect(result.properties[0].address.street).toBe("1 Example Street");
+    expect(JSON.stringify(result)).not.toMatch(/billingAccountId|accounts|private-commercial/);
+  });
+  it("rejects malformed or draft V1 records instead of fabricating legacy answers", () => {
+    expect(() => parseAcceptedGhlHandoff({ ...run(), status: "draft" })).toThrow();
+    expect(() => parseAcceptedGhlHandoff({ ...run(), submitted_payload: {} })).toThrow();
+  });
+  it("returns the accepted view before any legacy PDF generation/upload", async () => {
+    const response = await GET(new NextRequest("https://example.com/api/onboarding", { headers: { authorization: "Bearer assembly-token" } }));
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({ kind: "ghl-v1", handoff: { properties: [{ name: "Property One" }] } });
+    expect(effects.pdf).not.toHaveBeenCalled();
+    expect(effects.upload).not.toHaveBeenCalled();
+    expect(fetchMock.mock.calls.every((call) => !call[1]?.method || call[1].method === "GET")).toBe(true);
+  });
+  it("handles the old colon run ID without invoking the legacy run schema", async () => {
+    rows[0].external_key = `ghl-v1:${id(2)}`;
+    const response = await GET(new NextRequest("https://example.com/api/onboarding", { headers: { authorization: "Bearer assembly-token" } }));
+    expect(response.status).toBe(200);
+    expect(effects.pdf).not.toHaveBeenCalled();
+  });
+  it("does not route V1 through the legacy saved-state loader", async () => {
+    await expect(loadHubOnboardingState(viewer)).rejects.toMatchObject({ code: "locked" });
+  });
+  it("rejects a legacy form save for an accepted V1 run before any RPC", async () => {
+    await expect(saveHubOnboardingState(viewer, createDefaultState("company", rows[0].external_key))).rejects.toMatchObject({ code: "locked" });
+    expect(fetchMock.mock.calls.some((call) => call[1]?.method === "POST")).toBe(false);
+  });
+  it("rejects legacy attachment and verification mutations for V1", async () => {
+    await expect(recordHubOnboardingAttachment(viewer, rows[0].external_key, { id: "file", name: "x.pdf", contentType: "application/pdf", byteSize: 10 })).rejects.toMatchObject({ code: "locked" });
+    await expect(verifyHubInternalOnboardingTask({ ...viewer, surface: "internal", internalUserId: "team" }, rows[0].id, "pms")).rejects.toMatchObject({ code: "locked" });
+    expect(fetchMock.mock.calls.some((call) => call[1]?.method === "POST")).toBe(false);
+  });
+  it("excludes V1 before legacy queue parsing without failing the queue", async () => {
+    const result = await loadHubInternalOnboardingQueue({ ...viewer, surface: "internal", internalUserId: "team" });
+    expect(result).toEqual([]);
+    const query = fetchMock.mock.calls.map((call) => new URL(String(call[0]))).find((url) => url.pathname.endsWith("onboarding_runs"));
+    expect(query?.searchParams.get("external_key")).toBe("not.like.ghl-v1*");
+  });
+  it("keeps legacy clients in a mixed internal queue", async () => {
+    rows.push({ ...run(), id: id(99), external_key: "initial-existing", status: "draft", draft_payload: createDefaultState("company", "initial-existing"), submitted_payload: null });
+    const result = await loadHubInternalOnboardingQueue({ ...viewer, surface: "internal", internalUserId: "team" });
+    expect(result).toHaveLength(1);
+    expect(result[0].externalKey).toBe("initial-existing");
+    expect(result[0].state.runId).toBe("initial-existing");
+  });
+  it("renders prelaunch timing and human goal labels", () => {
+    const handoff = parseAcceptedGhlHandoff(run());
+    handoff.properties[0].status = "pre_launch";
+    handoff.properties[0].targetLaunchDate = "2026-10-15";
+    handoff.properties[0].preferences.goal = "balanced";
+    const html = renderToStaticMarkup(createElement(AcceptedOnboardingSummary, { handoff, onOpenMessages: () => undefined }));
+    expect(html).toContain("Preparing to launch");
+    expect(html).toContain("October 15, 2026");
+    expect(html).toContain("Balanced revenue and occupancy");
+  });
+  it("renders accepted properties and pending setup with no questionnaire inputs", () => {
+    const html = renderToStaticMarkup(createElement(AcceptedOnboardingSummary, { handoff: parseAcceptedGhlHandoff(run()), onOpenMessages: () => undefined }));
+    expect(html).toContain("Property One");
+    expect(html).toContain("1 Example Street");
+    expect(html).toContain("Setup help requested");
+    expect(html).toContain("Live");
+    expect(html).not.toContain("GHL");
+    expect(html).toContain("team verification pending");
+    expect(html).not.toMatch(/<input|<textarea|<select|<form/);
+    expect(html.match(/1 Example Street/g)).toHaveLength(1);
+  });
+});
