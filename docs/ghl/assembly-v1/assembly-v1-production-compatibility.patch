+import { z } from "zod";
+
+export type GhlV1RunIdentity = { external_key: string; submitted_payload: unknown };
+export function isGhlV1Run(run: GhlV1RunIdentity) {
+  const payload = run.submitted_payload;
+  return /^ghl-v1[:-]/.test(run.external_key)
+    || !!(payload && typeof payload === "object" && "version" in payload && payload.version === "rf.onboarding.v1");
+}
+const money = z.discriminatedUnion("mode", [
+  z.object({ mode: z.literal("specified"), value: z.number().finite().min(0) }),
+  z.object({ mode: z.literal("guidance") }), z.object({ mode: z.literal("none") })
+]);
+const stay = z.discriminatedUnion("mode", [
+  z.object({ mode: z.literal("specified"), nights: z.number().int().min(1).max(365) }),
+  z.object({ mode: z.literal("guidance") }), z.object({ mode: z.literal("none") })
+]);
+const acceptedPayload = z.object({
+  version: z.literal("rf.onboarding.v1"), journeyId: z.string().uuid(),
+  properties: z.array(z.object({
+    id: z.string().uuid(), name: z.string().min(1),
+    address: z.object({ street: z.string().min(1), unit: z.string().default(""), city: z.string().min(1), region: z.string(), postalCode: z.string(), country: z.string().length(2) }),
+    listingUrl: z.string().url().refine((url) => ["https:", "http:"].includes(new URL(url).protocol)).nullable(),
+    status: z.enum(["live", "pre_launch"]), targetLaunchDate: z.string().date().nullable(), identityConfirmed: z.literal(true),
+    preferences: z.object({ goal: z.enum(["revenue", "occupancy", "balanced", "guidance"]), minimumNightly: money, cleaningFee: money, minimumStay: stay, operatingConstraints: z.string() })
+  })).min(1).max(5),
+  software: z.object({ pmsName: z.string().nullable(), pms: z.enum(["done", "need_help", "not_applicable"]), airbnb: z.enum(["done", "need_help"]), pricelabs: z.enum(["done", "need_help"]) }),
+  expectationsAcknowledged: z.literal(true)
+});
+export type AcceptedGhlHandoff = z.infer<typeof acceptedPayload> & { submittedAt: string | null };
+export function parseAcceptedGhlHandoff(run: GhlV1RunIdentity & { status: string; submitted_at: string | null }): AcceptedGhlHandoff {
+  if (!["submitted", "in_review", "ready_for_launch", "live"].includes(run.status)) throw new Error("accepted_handoff_not_available");
+  const parsed = acceptedPayload.safeParse(run.submitted_payload);
+  if (!parsed.success || new Set(parsed.data.properties.map((p) => p.id)).size !== parsed.data.properties.length) throw new Error("accepted_handoff_invalid");
+  // Explicit schema projection strips pricing contracts, provider IDs, and internal notes.
+  return { ...parsed.data, submittedAt: run.submitted_at };
+}
